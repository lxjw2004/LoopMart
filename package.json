{
  "name": "loopmart",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test --test-concurrency=1 tests/foundation.test.ts tests/test-database.test.ts tests/api.validation.test.ts packages/ui/src/*.test.ts apps/api/src/item-filters.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@loopmart/web && npm run typecheck --workspace=@loopmart/admin",
    "build": "npm run build:server && npm run build --workspace=@loopmart/web && npm run build --workspace=@loopmart/admin && node scripts/prepare-standalone.mjs",
    "auth": "node --env-file=.env dist/apps/auth/src/server.js",
    "auth:migrate": "node --env-file=.env dist/apps/auth/src/migrate.js",
    "test:integration": "node --env-file=.env.test --import tsx --test --test-concurrency=1 tests/auth.integration.test.ts tests/api.integration.test.ts",
    "build:server": "tsc && node scripts/copy-migrations.mjs",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.22",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
